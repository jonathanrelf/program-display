#include <plugin-support.h>

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

const char *PLUGIN_NAME = "@CMAKE_PROJECT_NAME@";
const char *PLUGIN_VERSION = "@CMAKE_PROJECT_VERSION@";

void obs_log(int log_level, const char *format, ...)
{
  const size_t length = 4 + strlen(PLUGIN_NAME) + strlen(format);
  char *message_template = malloc(length + 1);
  if (!message_template) {
    return;
  }

  snprintf(message_template, length + 1, "[%s] %s", PLUGIN_NAME, format);

  va_list args;
  va_start(args, format);
  blogva(log_level, message_template, args);
  va_end(args);

  free(message_template);
}
